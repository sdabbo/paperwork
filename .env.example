# Copy to .env for local development (npm run dev) and for deploy/setup.sh. setup.sh asks for whatever of PROJECT_ID,
# GEMINI_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and ALLOWED_EMAILS is missing here, keeps the non-secret ones
# in this file and the secrets in Secret Manager only (DEPLOY.md, "Quick start"). Running locally needs the Google
# client and the Gemini key here. Never commit .env (.gitignore leaves it out).

# ---------- Google ----------
# The Google Cloud project Paperwork runs in (its ID; deploy scripts)
PROJECT_ID=""
# OAuth client ("Web application") for signing in and for Drive (DEPLOY.md, "Google sign-in and Drive access").
# Its redirect URIs must include Paperwork's /auth/callback and, for local development, http://localhost:3000/auth/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ALLOWED_EMAILS: comma-separated Google accounts that may sign in.
# Locally, empty allows any account.
ALLOWED_EMAILS=""

# DRIVE_ACCESS: "app" (default) or "full".
# app:  Google's narrow "drive.file" permission: Paperwork sees only files it created and files you pick in
#       Google's file picker (Add documents › From Google Drive, e.g. scans made with the Drive app).
# full: Google's "drive" permission, so scans the Google Drive app saves into the Inbox folder are seen without
#       picking them.
# Either way Paperwork never deletes, trashes, shares or overwrites anything, and touches nothing outside its
# folder except a picked file it moves into its Inbox (server/drive.ts, server/vault.ts).
DRIVE_ACCESS=""
# Browser key for Google's file picker; deploy/setup.sh makes one and deploy.sh uses it. Locally, to try the
# picker, put that key here (gcloud services api-keys list; it works from http://localhost:3000 too).
PICKER_API_KEY=""
# Name of the folder Paperwork creates at the top of your Drive
DRIVE_FOLDER_NAME="Paperwork"
# APP_LANGUAGE: "en" or "de": language of folder names, titles and summaries
APP_LANGUAGE="en"

# ---------- Gemini ----------
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Tried in order; later models are only used when earlier ones fail
GEMINI_MODELS="gemini-3.8-flash,gemini-2.5-flash"
# Daily budget for all Gemini calls. When reached, new documents wait in the Inbox until midnight UTC.
GEMINI_DAILY_REQUEST_LIMIT=500
GEMINI_DAILY_TOKEN_LIMIT=5000000
# Embeddings let search find documents by meaning. This model turns each piece of a document's text (and each
# search) into 768 numbers. Vectors from different models don't compare, so after changing the model the index
# has to be rebuilt: remove the paperworkDocs and paperworkChunks collections in Firestore and deploy again (the
# server keeps the index in memory and otherwise reads it again only at its daily full check; locally: stop the
# server, remove data/index/, start it). Paperwork rebuilds the index from Drive over the next runs, reading every
# document again; deadlines come back from each file's description. Nothing in Drive changes; only which
# deadlines were ticked off is lost.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Daily budget for embeddings: one per ~3,500 characters of text when a document is indexed, one per search.
# When it is reached, searching by meaning pauses until midnight UTC and new documents get their embeddings then;
# searching by words keeps working.
GEMINI_DAILY_EMBEDDING_LIMIT=5000

# ---------- Storage ----------
# STORAGE: "firestore" keeps Paperwork's search index and settings in Firestore, as on Cloud Run: each document's
# details, deadlines, text and embeddings, plus the encrypted Drive connection, saved views and activity.
# Anything else uses JSON files under data/. The documents themselves are always in Google Drive.
STORAGE=""
# FIRESTORE_DB="(default)"
# APP_SECRET: at least 32 characters; signs sessions and encrypts the Drive token. Locally a fixed development
# value is used when empty; deploy/setup.sh makes a random one for Cloud Run.
APP_SECRET=""

# ---------- Email ----------
# Shared with the email worker or Postmark (see DEPLOY.md). deploy/setup.sh makes one for Cloud Run.
INBOUND_EMAIL_SECRET=""
# The address documents are sent to, shown in the app (Settings › Email can set it instead)
INBOUND_EMAIL_ADDRESS=""
# Who may send documents; defaults to ALLOWED_EMAILS (Settings › Email can add more)
INBOUND_ALLOWED_SENDERS=""

# ---------- Scheduled filing on Cloud Run ----------
# Cloud Scheduler calls /internal/cron (of the one service, or of the public edge) with a Google ID token for this
# service account (set by deploy/deploy.sh).
# CRON_SERVICE_ACCOUNT=""
# CRON_AUDIENCE=""

# ---------- Two services on Cloud Run (deploy/protect.sh split) ----------
# deploy/deploy.sh sets these on the app and the edge (DEPLOY.md, "Settings"). Leave them unset here: Paperwork
# then runs as one service, as always. To try the two roles side by side (DEPLOY.md, "Running locally"), give them
# in the shell that starts each server, never in .env: deploy/deploy.sh reads .env too.
# PAPERWORK_ROLE: unset (one service), "app" (behind Google's Identity-Aware Proxy) or "edge" (the public doors)
# PAPERWORK_ROLE=""
# PUBLIC_URL: the address AI apps and mail services use (the edge's); unset: APP_URL
# PUBLIC_URL=""
# IAP_AUDIENCE: what IAP's signed header must be issued for (the app):
#   /projects/<project number>/locations/<region>/services/paperwork-app
# IAP_AUDIENCE=""
# CRON_RELAY_ACCOUNT: the edge's service account: the identity the app lets in on /internal/cron, and the one the
# edge signs the scheduled run's JWT as. Never one of ALLOWED_EMAILS.
# CRON_RELAY_ACCOUNT=""
# CRON_RELAY_AUDIENCE: what the edge signs that JWT for; unset: <APP_URL>/internal/cron
# CRON_RELAY_AUDIENCE=""
# FINANCE_READER_ACCOUNT (optional): a finance app's service account, the only identity the app lets read its feed
# (/internal/finance/…); set on Cloud Run by deploy/protect.sh finance, unused locally
# FINANCE_READER_ACCOUNT=""
